    <!-- Собственное оформление второго Activity: тёмный фон и светлый текст. -->
    <style name="Theme.GuessNumber.Second" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/guess_background</item>
        <item name="android:navigationBarColor">@color/guess_background</item>
        <item name="android:colorAccent">@color/guess_accent</item>
