<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Первый экран: компьютер угадывает число пользователя. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_surface"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_title"
                android:textColor="@color/ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/main_subtitle"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/range_label"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/minInput"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_surface"
                    android:gravity="center"
                    android:hint="@string/range_from_hint"
                    android:inputType="numberSigned"
                    android:maxLength="9"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:text="1"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:text="@string/range_dash"
                    android:textColor="@color/muted"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/maxInput"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_surface"
                    android:gravity="center"
                    android:hint="@string/range_to_hint"
                    android:inputType="numberSigned"
                    android:maxLength="9"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:text="100"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/rangeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/startButton"
                style="?android:attr/buttonStyle"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_primary"
                android:stateListAnimator="@null"
                android:text="@string/button_start"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <!-- Панель игры появляется после нажатия «Загадать число». -->
            <LinearLayout
                android:id="@+id/guessPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/input_surface"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/attemptView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/questionView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/lessButton"
                        style="?android:attr/buttonStyle"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_surface"
                        android:stateListAnimator="@null"
                        android:text="@string/button_less"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/greaterButton"
                        style="?android:attr/buttonStyle"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_surface"
                        android:stateListAnimator="@null"
                        android:text="@string/button_greater"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/correctButton"
                    style="?android:attr/buttonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_primary"
                    android:stateListAnimator="@null"
                    android:text="@string/button_correct"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/resultView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/result_surface"
                android:gravity="center"
                android:padding="14dp"
                android:textColor="@color/success"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/restartButton"
                style="?android:attr/buttonStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_surface"
                android:stateListAnimator="@null"
                android:text="@string/button_restart"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Переход на второе Activity. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_surface"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/second_screen_title"
                android:textColor="@color/ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/second_screen_subtitle"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/openGuessButton"
                style="?android:attr/buttonStyle"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_primary"
                android:stateListAnimator="@null"
                android:text="@string/button_open_guess"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/secondScreenResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/result_surface"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/success"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
