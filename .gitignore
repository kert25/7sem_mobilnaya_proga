# Локальная JDK для Gradle ставится setup-android.ps1 во внешнюю папку
# (%LOCALAPPDATA%\MobileLabs\jdk-17), поэтому в проекте её быть не должно.
_android-tools/

# Локальная конфигурация машины
local.properties
.gradle/

# Временные логи проверок
*.log

# Сгенерированное сборкой
**/build/
**/.kotlin/
__pycache__/
_tools/kotlin/

# Android Studio: настройки проекта хранятся в git,
# рабочее состояние окна и кеши — нет.
**/.idea/
!.idea/
!.idea/**

*.jar
*.idsig
# The Gradle wrapper jar must be committed: a clone without it cannot build.
# Правило-исключение должно идти после `*.jar`, иначе оно не действует.
!**/gradle/wrapper/gradle-wrapper.jar

# Временные файлы Word
~$*.docx
