<?xml version="1.0" encoding="utf-8"?>
<!-- Экран заметки. Корневой LinearLayout с id sheet нужен для смены фона листа
     из onResume: Activity не пересоздаётся при перелистывании. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sheet_1"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sheetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/counter_surface"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Управление размером шрифта заметки. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/font_label"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/fontDecrease"
                style="?android:attr/buttonStyle"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:background="@drawable/button_surface"
                android:stateListAnimator="@null"
                android:text="@string/font_decrease"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/fontValue"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/fontIncrease"
                style="?android:attr/buttonStyle"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:background="@drawable/button_surface"
                android:stateListAnimator="@null"
                android:text="@string/font_increase"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Поле заметки занимает всю свободную область листа. Параметр
         android:background="@null" убирает подчёркивание под текстом. -->
    <EditText
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="top|start"
        android:hint="@string/note_hint"
        android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="16sp" />

    <Button
        android:id="@+id/next"
        style="?android:attr/buttonStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:background="@drawable/button_primary"
        android:stateListAnimator="@null"
        android:text="@string/button_next_sheet"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />
</LinearLayout>
