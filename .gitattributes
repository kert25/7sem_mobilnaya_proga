# Единые переводы строк: скрипты Windows — CRLF, остальное — LF.
* text=auto

*.bat   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# gradlew запускается и в bash, где CRLF ломает shebang.
gradlew text eol=lf

*.kt    text eol=lf
*.kts   text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.properties text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Бинарные файлы не трогаем.
*.jar   binary
*.apk   binary
*.png   binary
*.jpg   binary
*.docx  binary
*.pdf   binary
