<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/redColor"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_surface"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/title"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/subtitle"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/sampleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:minHeight="120dp"
            android:text="@string/sample_text"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sizeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/smallerButton"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_surface"
                android:text="@string/button_smaller"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <Button
                android:id="@+id/largerButton"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_surface"
                android:text="@string/button_larger"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <Button
                android:id="@+id/resetButton"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_surface"
                android:text="@string/button_reset"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/background_label"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/redButton"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/swatch_red"
                android:contentDescription="@string/color_red"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/yellowButton"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/swatch_yellow"
                android:contentDescription="@string/color_yellow"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/greenButton"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/swatch_green"
                android:contentDescription="@string/color_green"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:alpha="0.85"
            android:gravity="center"
            android:text="@string/footer"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
