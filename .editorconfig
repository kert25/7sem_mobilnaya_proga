root = true

# В проекте русские строки в коде и ресурсах: кодировка должна быть одинаковой
# в редакторе, Gradle и Android Studio.
[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{xml,json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell (powershell.exe) читает файл без BOM как ANSI и портит
# кириллицу в путях, поэтому скриптам нужен BOM.
[*.{ps1,psm1}]
charset = utf-8-bom
